  <tag k="addr:city" v="小山市東城南"/>
  <tag k="addr:housenumber" v="1-31-7"/>
  <tag k="addr:postcode" v="3230829"/>
  <tag k="description" v="栃木県で婚約指輪、結婚指輪を探すカップルに人気。創業40年以上の宝石店、ELEGANCE。  宝飾加工職人としてスタートしたオーナーが居る、宝飾・時計の専門店。指輪のサイズ直しや切れたネックレスの修理、宝飾品リフォーム、新品仕上げ等、宝飾にかかわることなら何でも御相談下さい。時計の電池交換や防水テストなども承っております。宝飾品・地金の買取りもご相談ください。"/>
  <tag k="name" v="ELEGANCE"/>
  <tag k="opening_hours" v="11:00-19:00"/>
  <tag k="operator" v="株式会社ジュエルエレガンス"/>
  <tag k="phone" v="0285314866"/>
  <tag k="shop" v="jewelry"/>
  <tag k="source" v="株式会社ジュエルエレガンス"/>
  <tag k="website" v="https://jewelelegance.co.jp/"/>
 </node>
